#define _CRT_SECURE_NO_WARNINGS
#include<stdio.h>

int main()
{
    int n, t;
    scanf("%d %d", &n, &t);

    if (n > 5000) {
        goto end;
    }
    int arr[5000] = { 0 };
    for (int i = 0; i <= n - 1; i++) {
        scanf("%d", arr[i]);
    }

    for (int p = 0; p <= n - 1; p++) {
        arr[p] = arr[p] % t;
        if (arr[p] > t / 2) {
            arr[p] = t - arr[p];
        }
    }
    int sum = 0;
    for (int q = 0; q <= n - 1; q++) {
        sum += arr[q];
    }
    int result = sum / n;

    printf("%d", &result);
end:
    return 0;
}
